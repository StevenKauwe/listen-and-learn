<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Do-Re-Mi — browser-test fixture (input contract reference)</title>
<style>
  /* The no-scroll contract: nothing here may scroll, ever. */
  html, body { margin: 0; height: 100%; overflow: hidden; position: fixed;
               width: 100%; overscroll-behavior: none; touch-action: none;
               background: #fdf6ec; font-family: system-ui, sans-serif; }
  main { height: 100%; display: flex; flex-direction: column; }
  header { text-align: center; padding: 6vmin 0 2vmin; font-size: 5vmin; color: #7a5c3e; }
  #notes { flex: 1; display: flex; align-items: stretch; justify-content: space-around;
           gap: 2vmin; padding: 0 2vmin 6vmin; flex-wrap: wrap; }
  .note { flex: 1 1 0; min-width: 14vmin; min-height: 40vmin; border-radius: 6vmin;
          border: none; touch-action: none; font-size: 6vmin; font-weight: 700;
          color: #fff; display: flex; align-items: center; justify-content: center; }
  /* Landscape keeps every button visible: rows shrink, wrap stays on. */
  @media (orientation: landscape) { .note { min-height: 30vmin; } }
</style>
</head>
<body>
<main>
  <header>listen…</header>
  <div id="notes"></div>
</main>
<script>
/* The input contract the real app must honor (spec §10). This fixture is a
 * reference implementation of the CONTRACT, not the game: every acceptance
 * behavior is observable via data-* attributes on <body>. */
(function () {
  const NOTES = [
    ["do", "#e74c3c"], ["re", "#e67e22"], ["mi", "#f1c40f"],
    ["fa", "#27ae60"], ["so", "#2980b9"],
  ];
  const SLOP = 20;          // px: a drag within this is still a tap
  const HOLD_MS = 2000;     // a 2 s hold guesses once
  const state = { guesses: 0, last: null, audio: "none", errors: 0 };

  const notes = document.getElementById("notes");
  for (const [name, color] of NOTES) {
    const b = document.createElement("button");
    b.className = "note"; b.id = "note-" + name; b.textContent = name;
    b.style.background = color;
    notes.appendChild(b);
  }

  // The guess FSM: one active pointer, one guess per gesture, slop-tolerant.
  let active = null; // { id, x, y, button, holdTimer, holdFired }
  function guess(name) {
    state.guesses += 1; state.last = name;
    document.body.dataset.guesses = String(state.guesses);
    document.body.dataset.last = name;
  }
  function buttonFromPoint(x, y) {
    const el = document.elementFromPoint(x, y);
    return el && el.classList.contains("note") ? el.id.slice(5) : null;
  }

  addEventListener("pointerdown", (e) => {
    if (active) return;                    // two fingers: second is ignored
    const name = buttonFromPoint(e.clientX, e.clientY);
    if (!name) return;
    e.preventDefault();                    // and the page never scrolls
    active = { id: e.pointerId, x: e.clientX, y: e.clientY, button: name,
               holdFired: false, holdTimer: 0 };
    active.holdTimer = setTimeout(() => {
      if (active && !active.holdFired) { active.holdFired = true; guess(active.button); }
    }, HOLD_MS);
    startAudio();
  });
  addEventListener("pointermove", (e) => {
    if (!active || e.pointerId !== active.id) return;
    const d = Math.hypot(e.clientX - active.x, e.clientY - active.y);
    if (d > SLOP && !active.holdFired) {   // a real drag cancels the tap/hold
      clearTimeout(active.holdTimer); active.canceled = true;
    }
  });
  addEventListener("pointerup", (e) => {
    if (!active || e.pointerId !== active.id) return;
    clearTimeout(active.holdTimer);
    const d = Math.hypot(e.clientX - active.x, e.clientY - active.y);
    if (!active.canceled && !active.holdFired && d <= SLOP) guess(active.button);
    active = null;
  });
  addEventListener("pointercancel", (e) => {
    if (active && e.pointerId === active.id) { clearTimeout(active.holdTimer); active = null; }
  });

  // Sound: at least initializes. Created and resumed on the first touch.
  let ac = null;
  function startAudio() {
    if (ac) { ac.resume && ac.resume(); return; }
    try {
      ac = new (window.AudioContext || window.webkitAudioContext)();
      ac.resume && ac.resume();
      state.audio = ac.state || "init";
    } catch (err) { state.audio = "error"; }
    document.body.dataset.audio = state.audio;
  }

  // Error accounting: the offline row asserts zero page errors.
  addEventListener("error", () => { state.errors += 1; document.body.dataset.errors = String(state.errors); });

  document.body.dataset.guesses = "0";
  document.body.dataset.audio = "none";
  document.body.dataset.errors = "0";

  // Offline: a cache-first service worker, so the page survives a dead server.
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("sw.js").then(() => {
      document.body.dataset.sw = "registered";
    }).catch(() => { document.body.dataset.sw = "failed"; });
  } else {
    document.body.dataset.sw = "unsupported";
  }
})();
</script>
</body>
</html>
